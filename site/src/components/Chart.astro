---
/**
 * Chart Component
 *
 * Single Responsibility: Display a chart image with caption.
 * DRY: Centralizes all chart display logic.
 */

interface Props {
  chartId: string;
  renderer?: "altair" | "plot";
  title: string;
  caption: string;
  wide?: boolean;
}

const { chartId, renderer = "altair", title, caption, wide = false } = Astro.props;

const imgSrc = `/graphyard/assets/charts/${renderer}/${chartId}.svg`;
---

<figure class:list={[{ wide }]}>
  <img src={imgSrc} alt={`Chart: ${title}`} loading="lazy" />
  <figcaption>
    <strong>{title}</strong>
    {caption}
  </figcaption>
</figure>

<style>
  figure {
    margin: 2.5rem 0;
  }

  figure img {
    width: 100%;
    height: auto;
    display: block;
    background: #fafafa;
    border-radius: 8px;
    padding: 1rem;
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--color-text-muted, #4a5568);
    line-height: 1.6;
  }

  figcaption strong {
    display: block;
    color: var(--color-text, #1a1a2e);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  figure.wide {
    max-width: 960px;
  }

  @media (min-width: 1100px) {
    figure.wide {
      width: 960px;
      margin-left: calc((720px - 960px) / 2);
    }
  }
</style>
