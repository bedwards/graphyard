---
/**
 * Graphyard Home Page
 *
 * Landing page with articles organized by domain.
 * Articles within each domain are sorted reverse chronologically (latest first).
 * Category tags distinguish "Latest Research" from "Pushing the Boundaries".
 */

import { domains, getAllArticles, getArticlesByDomain, categoryInfo } from "../lib/articles";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Graphyard: Data-driven explorations of economics and the world." />
    <title>Graphyard</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --color-text: #1a1a2e;
        --color-text-muted: #4a5568;
        --color-background: #ffffff;
        --color-accent: #2563eb;
        --color-accent-purple: #7c3aed;
        --color-border: #e5e7eb;
        --font-sans: 'Lexend', system-ui, sans-serif;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: var(--font-sans);
        color: var(--color-text);
        background: var(--color-background);
        line-height: 1.6;
      }

      main {
        max-width: 720px;
        margin: 0 auto;
        padding: 4rem 1.5rem;
      }

      header {
        margin-bottom: 4rem;
      }

      h1 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
      }

      .tagline {
        color: var(--color-text-muted);
        font-size: 1.125rem;
      }

      .domain-section {
        margin-bottom: 3rem;
      }

      .domain-header {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
      }

      h2 {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--color-text);
      }

      .domain-description {
        font-size: 0.875rem;
        color: var(--color-text-muted);
      }

      .articles {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .article-card {
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 1.5rem;
        transition: border-color 0.2s, box-shadow 0.2s;
      }

      .article-card:hover {
        border-color: var(--color-accent);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.1);
      }

      .article-card a {
        text-decoration: none;
        color: inherit;
        display: block;
      }

      .article-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.5rem;
      }

      .article-card h3 {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--color-accent);
        flex: 1;
      }

      .category-tag {
        font-size: 0.7rem;
        font-weight: 500;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.025em;
        white-space: nowrap;
      }

      .category-tag.latest-research {
        background: rgba(37, 99, 235, 0.1);
        color: var(--color-accent);
      }

      .category-tag.pushing-boundaries {
        background: rgba(124, 58, 237, 0.1);
        color: var(--color-accent-purple);
      }

      .article-card p {
        color: var(--color-text-muted);
        margin-bottom: 0.75rem;
        line-height: 1.5;
      }

      .article-meta {
        display: flex;
        gap: 1rem;
        font-size: 0.875rem;
        color: var(--color-text-muted);
      }

      .article-meta span {
        display: flex;
        align-items: center;
        gap: 0.25rem;
      }

      .no-articles {
        padding: 2rem;
        text-align: center;
        color: var(--color-text-muted);
        background: #f9fafb;
        border-radius: 8px;
      }

      footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
        text-align: center;
        font-size: 0.875rem;
        color: var(--color-text-muted);
      }
    </style>
  </head>

  <body>
    <main>
      <header>
        <h1>Graphyard</h1>
        <p class="tagline">Data-driven explorations of economics and the world.</p>
      </header>

      {domains.map((domain) => {
        const domainArticles = getArticlesByDomain(domain.id);
        if (domainArticles.length === 0) return null;

        return (
          <section class="domain-section">
            <div class="domain-header">
              <h2>{domain.name}</h2>
              <span class="domain-description">{domain.description}</span>
            </div>
            <div class="articles">
              {domainArticles.map((article) => (
                <article class="article-card">
                  <a href={`/graphyard/articles/${article.slug}/`}>
                    <div class="article-header">
                      <h3>{article.title}</h3>
                      <span class={`category-tag ${article.category}`}>
                        {categoryInfo[article.category].label}
                      </span>
                    </div>
                    <p>{article.description}</p>
                    <div class="article-meta">
                      <span>{article.readingTime} read</span>
                      <span>{new Date(article.publishDate).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                      })}</span>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </section>
        );
      })}

      <footer>
        <p>Charts powered by Altair + Vega-Lite. Built with Astro.</p>
      </footer>
    </main>
  </body>
</html>
