---
import Nav from "../components/Nav.astro";

interface Props {
  title: string;
  description: string;
  author?: string;
  publishDate?: string;
  readingTime?: string;
}

const { title, description, author = "Brian Edwards", publishDate, readingTime } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Graphyard</title>

    <!-- Lexend Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      :root {
        --color-text: #1a1a2e;
        --color-text-muted: #4a5568;
        --color-background: #ffffff;
        --color-accent: #2563eb;
        --color-border: #e5e7eb;

        --font-sans: 'Lexend', system-ui, -apple-system, sans-serif;
        --font-mono: 'JetBrains Mono', 'Fira Code', monospace;

        --content-width: 720px;
        --content-width-wide: 960px;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        font-size: 18px;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      body {
        font-family: var(--font-sans);
        color: var(--color-text);
        background: var(--color-background);
      }

      /* Typography Scale */
      h1 {
        font-size: 2.5rem;
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 1rem;
      }

      h2 {
        font-size: 1.75rem;
        font-weight: 600;
        line-height: 1.3;
        margin-top: 3rem;
        margin-bottom: 1rem;
      }

      h3 {
        font-size: 1.25rem;
        font-weight: 600;
        line-height: 1.4;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
      }

      p {
        margin-bottom: 1.5rem;
      }

      /* Varying paragraph lengths feel natural */
      p + p {
        text-indent: 0;
      }

      a {
        color: var(--color-accent);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      /* Figure/Chart styling */
      figure {
        margin: 2.5rem 0;
        padding: 1.5rem;
        background: #fafafa;
        border-radius: 8px;
      }

      figure img {
        width: 100%;
        height: auto;
        display: block;
        margin-bottom: 1rem;
      }

      figcaption {
        font-size: 0.875rem;
        color: var(--color-text-muted);
        line-height: 1.5;
      }

      figcaption strong {
        display: block;
        color: var(--color-text);
        margin-bottom: 0.25rem;
      }

      /* Wide figures break out of content width */
      figure.wide {
        width: calc(100% + 4rem);
        margin-left: -2rem;
        margin-right: -2rem;
      }

      @media (min-width: 1100px) {
        figure.wide {
          width: var(--content-width-wide);
          margin-left: calc((var(--content-width) - var(--content-width-wide)) / 2);
        }
      }

      /* Lists */
      ul, ol {
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
      }

      li {
        margin-bottom: 0.5rem;
      }

      /* Blockquotes */
      blockquote {
        border-left: 4px solid var(--color-accent);
        padding-left: 1.5rem;
        margin: 2rem 0;
        font-style: italic;
        color: var(--color-text-muted);
      }

      /* Code */
      code {
        font-family: var(--font-mono);
        font-size: 0.875em;
        background: #f1f5f9;
        padding: 0.125rem 0.375rem;
        border-radius: 4px;
      }

      pre {
        background: #1e293b;
        color: #e2e8f0;
        padding: 1.5rem;
        border-radius: 8px;
        overflow-x: auto;
        margin-bottom: 1.5rem;
      }

      pre code {
        background: none;
        padding: 0;
      }

      /* Definition terms for concepts */
      .definition {
        background: linear-gradient(135deg, #eff6ff 0%, #f0fdf4 100%);
        border-left: 4px solid var(--color-accent);
        padding: 1.25rem 1.5rem;
        margin: 2rem 0;
        border-radius: 0 8px 8px 0;
      }

      .definition dt {
        font-weight: 600;
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
      }

      .definition dd {
        color: var(--color-text-muted);
      }

      /* Print styles for PDF */
      @media print {
        body {
          font-size: 11pt;
        }

        figure {
          break-inside: avoid;
          page-break-inside: avoid;
        }

        h2, h3 {
          break-after: avoid;
          page-break-after: avoid;
        }
      }
    </style>
  </head>

  <body>
    <div class="nav-wrapper">
      <Nav />
    </div>
    <article>
      <header class="article-header">
        <h1>{title}</h1>
        <div class="article-meta">
          <span class="author">{author}</span>
          {publishDate && <time datetime={publishDate}>{publishDate}</time>}
          {readingTime && <span class="reading-time">{readingTime} read</span>}
        </div>
      </header>

      <div class="article-content">
        <slot />
      </div>
    </article>

    <style>
      .nav-wrapper {
        max-width: var(--content-width);
        margin: 0 auto;
        padding: 1rem 1.5rem 0;
      }

      article {
        max-width: var(--content-width);
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
      }

      .article-header {
        margin-bottom: 3rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--color-border);
      }

      .article-meta {
        display: flex;
        gap: 1.5rem;
        color: var(--color-text-muted);
        font-size: 0.875rem;
      }

      .article-content {
        /* Content from MDX goes here */
      }

      @media (max-width: 768px) {
        .nav-wrapper {
          padding: 0.5rem 1rem 0;
        }

        article {
          padding: 1rem 1rem 2rem;
        }

        h1 {
          font-size: 2rem;
        }

        .article-meta {
          flex-direction: column;
          gap: 0.5rem;
        }
      }
    </style>
  </body>
</html>
